        516.87,
        528.26,
        548.25
      ]
    },
    {
      "text": "Packet\nSize\nFlow\n1\n100\n1\n2\n100\n1\n3\n100\n1\n4\n100\n1\n5\n40\n1\n6\n190\n2\n7\n120\n2\n8\n10\n2\n9\n210\n3\n10\n20\n3\n",
      "page": 6,
